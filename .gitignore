# Build output
build/
new/build/
old/build/

# Local scan test data (keep empty folder; ignore sample files)
test_scan/*
!test_scan/.gitkeep
old/test_scan/*
!old/test_scan/.gitkeep
new/test_scan/*
!new/test_scan/.gitkeep

# Runtime data (logs, cache, resume checkpoint, quarantine)
**/runtime/logs/*
!**/runtime/logs/.gitkeep

**/runtime/cache/*
!**/runtime/cache/.gitkeep

**/runtime/resume/*
!**/runtime/resume/.gitkeep

**/runtime/quarantine/metadata.json
**/runtime/quarantine/files/*
!**/runtime/quarantine/files/.gitkeep
